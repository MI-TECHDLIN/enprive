# Copy to android/key.properties (gitignored via android/.gitignore) for local
# production-signed release builds, or provide ENPRIVE_RELEASE_* environment variables.
storeFile=path/to/release-keystore.jks
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=REPLACE_WITH_KEY_ALIAS
keyPassword=REPLACE_WITH_KEY_PASSWORD
