  "learnPermissionsFolderTitle": "Phone permissions",
  "@learnPermissionsFolderTitle": {
    "description": "Short folder title for Lesson 2 on the Learn home screen"
  },
  "learnPermissionsTitle": "Android permissions explained",
  "@learnPermissionsTitle": {
    "description": "Full lesson title for Lesson 2"
  },
  "learnPermissionsSubtitle": "The four Android choices & where to review them",
  "@learnPermissionsSubtitle": {
    "description": "Short subtitle for Lesson 2"
  },
  "learnPermissionsIntro": "Permissions are gates that control whether an app can reach sensors and data on your phone, such as the camera, microphone, location, photos, contacts, or notifications.",
  "@learnPermissionsIntro": {
    "description": "Plain-language introduction for Lesson 2"
  },
  "learnPermissionsStep1": "Ask whether the permission fits the feature: a math quiz or reading app rarely needs your location, contacts, or camera.",
  "@learnPermissionsStep1": {
    "description": "Step 1 of Lesson 2"
  },
  "learnPermissionsStep2": "Android offers up to four choices: Don't allow, Ask every time, Allow only while using the app, and All the time (for background location).",
  "@learnPermissionsStep2": {
    "description": "Step 2 of Lesson 2 explaining Android's four permission choices"
  },
  "learnPermissionsStep3": "Start with the narrowest choice that lets the feature work — such as Ask every time or While using the app.",
  "@learnPermissionsStep3": {
    "description": "Step 3 of Lesson 2"
  },
  "learnPermissionsStep4": "Open Android Settings and check Privacy Dashboard to see which apps recently accessed Camera, Microphone, or Location.",
  "@learnPermissionsStep4": {
    "description": "Step 4 of Lesson 2 explaining where to review recent permission use"
  },
  "learnPermissionsStep5": "Turn permissions off anytime in App Settings, or keep Pause app activity if unused on so Android removes old permissions automatically. An allowed permission shows capability, not proof that data was sent.",
  "@learnPermissionsStep5": {
