  "learnPolicyFolderTitle": "Privacy policies",
  "@learnPolicyFolderTitle": {
    "description": "Short folder title for Lesson 1 on the Learn home screen"
  },
  "learnPolicyTitle": "What a privacy policy is (and what it can't prove)",
  "@learnPolicyTitle": {
    "description": "Full lesson title for Lesson 1"
  },
  "learnPolicySubtitle": "What developers promise vs. what stays unknown",
  "@learnPolicySubtitle": {
    "description": "Short subtitle for Lesson 1"
  },
  "learnPolicyIntro": "A privacy policy is a developer's public statement explaining what data an app says it collects, why it uses it, who may receive it, and what choices families have.",
  "@learnPolicyIntro": {
    "description": "Plain-language introduction for Lesson 1"
  },
  "learnPolicyStep1": "Look for four basics: what data is collected, why the app needs it, who else may get it, and how you can ask for deletion.",
  "@learnPolicyStep1": {
    "description": "Step 1 of Lesson 1"
  },
  "learnPolicyStep2": "Confusing wording is common. A 2026 study of children's learning apps found that very few policies were easy to read, and most apps did not fully match what their policies stated.",
  "@learnPolicyStep2": {
    "description": "Step 2 of Lesson 1 referencing verified UNSW 2026 findings in plain words"
  },
  "learnPolicyStep3": "A privacy policy only shows what a developer says on paper. Reading it cannot prove what the app actually sends over the internet.",
  "@learnPolicyStep3": {
    "description": "Step 3 of Lesson 1"
  },
  "learnPolicyStep4": "Comparing a policy with your phone's permission settings gives a clearer view — while remembering that Enprive cannot see live internet traffic.",
  "@learnPolicyStep4": {
    "description": "Step 4 of Lesson 1"
  },
  "learnPolicyQuickQuestion": "What does reading an app's privacy policy prove?",
  "@learnPolicyQuickQuestion": {
    "description": "Quick check question for Lesson 1"
  },
  "learnPolicyQuickOption1": "That the app never sends data to anyone",
  "@learnPolicyQuickOption1": {
    "description": "First quick check option for Lesson 1"
  },
  "learnPolicyQuickOption2": "What the developer says — not what the app actually sends",
  "@learnPolicyQuickOption2": {
    "description": "Correct second quick check option for Lesson 1"
  },
  "learnPolicyQuickOption3": "That the phone's camera and mic are switched off",
  "@learnPolicyQuickOption3": {
    "description": "Third quick check option for Lesson 1"
  },
  "learnPolicyQuickCorrectFeedback": "That's right. A policy is the developer's public statement, not proof of what the app actually sends over the internet.",
  "@learnPolicyQuickCorrectFeedback": {
    "description": "Feedback shown when the user selects the right answer in Lesson 1"
  },
  "learnPolicyQuickTryAgainFeedback": "Not quite. Reading a policy only tells you what the developer says — it cannot prove internet activity or turn off phone permissions.",
  "@learnPolicyQuickTryAgainFeedback": {
    "description": "Feedback shown when the user selects another option in Lesson 1"
  },
