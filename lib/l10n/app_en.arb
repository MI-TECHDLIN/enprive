  "learnSharingFolderTitle": "Ads & third parties",
  "@learnSharingFolderTitle": {
    "description": "Short folder title for Lesson 3 on the Learn home screen"
  },
  "learnSharingTitle": "Who else gets data: ads, analytics & third parties",
  "@learnSharingTitle": {
    "description": "Full lesson title for Lesson 3"
  },
  "learnSharingSubtitle": "App maker vs. helpers, analytics & ad networks",
  "@learnSharingSubtitle": {
    "description": "Short subtitle for Lesson 3"
  },
  "learnSharingIntro": "Many free apps connect to other companies behind the scenes. Knowing who receives information helps families tell the difference between running the app and tracking kids across apps.",
  "@learnSharingIntro": {
    "description": "Plain-language introduction for Lesson 3"
  },
  "learnSharingStep1": "First party means the app maker itself — for example, saving homework progress or quiz scores so the app works.",
  "@learnSharingStep1": {
    "description": "Step 1 of Lesson 3"
  },
  "learnSharingStep2": "Helper companies are third parties that handle behind-the-scenes jobs like cloud storage or crash reports so bugs get fixed.",
  "@learnSharingStep2": {
    "description": "Step 2 of Lesson 3"
  },
  "learnSharingStep3": "Analytics tools measure how screens are used, while ad networks and data brokers may use an advertising ID to show targeted ads or profile activity across apps.",
  "@learnSharingStep3": {
    "description": "Step 3 of Lesson 3"
  },
  "learnSharingStep4": "Watch for broad phrases like 'trusted partners' or 'business purposes,' and check whether a policy explains how to opt out of personalized ads.",
  "@learnSharingStep4": {
    "description": "Step 4 of Lesson 3"
  },
  "learnSharingQuickQuestion": "A policy says the app shares information with 'third-party partners.' What is the best next question to ask?",
  "@learnSharingQuickQuestion": {
    "description": "Quick check question for Lesson 3"
  },
  "learnSharingQuickOption1": "Assume that means the app has no ads",
  "@learnSharingQuickOption1": {
    "description": "First quick check option for Lesson 3"
  },
  "learnSharingQuickOption2": "Assume every partner does the exact same job",
  "@learnSharingQuickOption2": {
    "description": "Second quick check option for Lesson 3"
  },
  "learnSharingQuickOption3": "Check whether those partners are helpers (like hosting) or ad networks that track across apps",
  "@learnSharingQuickOption3": {
    "description": "Correct third quick check option for Lesson 3"
  },
  "learnSharingQuickCorrectFeedback": "Spot on. Helper services keep the app running, while ad networks and data brokers may track activity across apps.",
  "@learnSharingQuickCorrectFeedback": {
    "description": "Feedback shown when the user selects the right answer in Lesson 3"
  },
  "learnSharingQuickTryAgainFeedback": "Look closer at what each partner does. Not all third parties are the same — some host data or fix crashes, while others run ads or tracking.",
  "@learnSharingQuickTryAgainFeedback": {
    "description": "Feedback shown when the user selects another option in Lesson 3"
  },
